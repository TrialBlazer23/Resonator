"source": [
"## EXPERIMENT 2: Early Warning Detection (Passive Monitoring)\n",
"This experiment proves our key scientific claim: CSD (Critical Slowing Down) and $AR(1)$ values rise BEFORE the model becomes visibly repetitive.\n",
"We configure the safety monitor to passively track the state variables without applying any remediations (thresholds set to infinity)."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"colab": {
"base_uri": "https://localhost:8080/",
"color_background": true
},
"id": "exp2-detection",
"outputId": "exp2-output"
},
"outputs": [],
"source": [
"import matplotlib.pyplot as plt\n",
"from transformers import LogitsProcessorList\n",
"from resonator import ChaosCore, ChaosConfig, plot_telemetry_dashboard\n",
"\n",
"print("="*60)\n",
"print("EXPERIMENT 2: Passive Detection Mode (Zero Intervention)")\n",
"print("="*60)\n",
"\n",
"# Max-out threshold bounds so that remediation never triggers\n",
"detect_only_config = ChaosConfig(\n",
"    stress_critical_threshold=999.0,\n",
"    schmitt_upper=999.0,\n",
"    orbit_penalty_strength=0.0,\n",
"    point_attractor_penalty=0.0,\n",
"    anchor_boost_strength=0.0,\n",
"    max_temperature=1.0,\n",
")\n",
"\n",
"DEMO_PROMPT = TRAP_PROMPTS[0]\n",
"inputs = tokenizer(DEMO_PROMPT, return_tensors="pt").to(device)\n",
"\n",
"core_detect = ChaosCore(model, tokenizer, config=detect_only_config, verbose=False)\n",
"set_seed(42)\n",
"\n",
"with core_detect:\n",
"    with torch.no_grad():\n",
"        output_detect = model.generate(\n",
"            inputs,\n",
"            max_new_tokens=150,\n",
