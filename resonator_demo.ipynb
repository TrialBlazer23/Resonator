"source": [
"# Install required dependencies\n",
"!pip install -q transformers torch matplotlib numpy\n",
"\n",
"import os\n",
"import sys\n",
"\n",
"# Build local 'resonator' package directly inside Google Colab workspace\n",
"os.makedirs("resonator", exist_ok=True)\n",
"\n",
"with open("resonator/init.py", "w") as f:\n",
"    f.write('''\"\"\"\nRESONATOR: Unsupervised Cognitive Safety for Autoregressive LLMs\n\"\"\"\n\nimport torch\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom typing import List, Dict, Any, Optional\nfrom collections import Counter\n\nclass TelemetryRecord:\n    def init(\n        self, \n        step: int, \n        token_id: int, \n        token_text: str, \n        entropy: float, \n        top_prob: float, \n        ar1: float, \n        stress: float, \n        orbit_period: Optional[int], \n        intervention_active: bool\n    ):\n        self.step = step\n        self.token_id = token_id\n        self.token_text = token_text\n        self.entropy = entropy\n        self.top_prob = top_prob\n        self.ar1 = ar1\n        self.stress = stress\n        self.orbit_period = orbit_period\n        self.intervention_active = intervention_active\n\nclass ChaosConfig:\n    def init(\n        self,\n        stress_critical_threshold: float = 1.2,\n        schmitt_upper: float = 1.2,\n        schmitt_lower: float = 0.5,\n        orbit_penalty_strength: float = 2.5,\n        point_attractor_penalty: float = 1.5,\n        anchor_boost_strength: float = 0.4,\n        max_temperature: float = 1.4,\n        ar1_threshold: float = 0.75,\n        orbit_distance_threshold: float = 0.05,\n        stress_rise_rate: float = 0.15,\n        stress_decay_rate: float = 0.08,\n    ):\n        self.stress_critical_threshold = stress_critical_threshold\n        self.schmitt_upper = schmitt_upper\n        self.schmitt_lower = schmitt_lower\n        self.orbit_penalty_strength = orbit_penalty_strength\n        self.point_attractor_penalty = point_attractor_penalty\n        self.anchor_boost_strength = anchor_boost_strength\n        self.max_temperature = max_temperature\n        self.ar1_threshold = ar1_threshold\n        self.orbit_distance_threshold = orbit_distance_threshold\n        self.stress_rise_rate = stress_rise_rate\n        self.stress_decay_rate = stress_decay_rate\n\nclass ChaosCore:\n    def init(self, model, tokenizer, config: ChaosConfig = None, verbose: bool = True):\n        self.model = model\n        self.tokenizer = tokenizer\n        self.config = config if config is not None else ChaosConfig()\n        self.verbose = verbose\n        self.telemetry: List[TelemetryRecord] = []\n        self.step_counter = 0\n        self.stress = 0.0\n        self.intervention_active = False\n        \n        self.entropy_history = []\n        self.generated_tokens = []\n        self.prompt_tokens = []\n\n    def enter(self):\n        self.telemetry = []\n        self.step_counter = 0\n        self.stress = 0.0\n        self.intervention_active = False\n        self.entropy_history = []\n        self.generated_tokens = []\n        self.prompt_tokens = []\n        return self\n\n    def exit(self, exc_type, exc_val, exc_tb):\n        pass\n\n    def get_telemetry(self) -> List[TelemetryRecord]:\n        return self.telemetry\n\n    def summary(self) -> Dict[str, Any]:\n        interventions = sum(1 for t in self.telemetry if t.intervention_active)\n        peak_stress = max((t.stress for t in self.telemetry), default=0.0)\n        peak_ar1 = max((t.ar1 for t in self.telemetry), default=0.0)\n        orbit_count = sum(1 for t in self.telemetry if t.orbit_period is not None)\n        return {\n            \"total_steps\": len(self.telemetry),\n            \"intervention_steps\": interventions,\n            \"peak_stress\": round(peak_stress, 4),\n            \"peak_ar1\": round(peak_ar1, 4),\n            \"orbit_detections\": orbit_count,\n            \"intervention_percentage\": f\"{(interventions / max(len(self.telemetry), 1)) * 100:.1f}%\",\n        }\n\n    def call(self, input_ids: torch.LongTensor, scores: torch.FloatTensor) -> torch.FloatTensor:\n        logits = scores[-1]\n        probs = torch.softmax(logits, dim=-1)\n        \n        entropy = -torch.sum(probs * torch.log(probs + 1e-12)).item()\n        top_prob, top_token_id = torch.max(probs, dim=-1)\n        top_prob = top_prob.item()\n        \n        if len(self.prompt_tokens) == 0:\n            self.prompt_tokens = input_ids[-1].tolist()\n\n        curr_token_id = input_ids[-1, -1].item()\n        self.generated_tokens.append(curr_token_id)\n        \n        # Lag-1 Autocorrelation of Token Entropy (Critical Slowing Down Metric)\n        self.entropy_history.append(entropy)\n        ar1_val = 0.0\n        window_size = 10\n        if len(self.entropy_history) >= window_size:\n            w = self.entropy_history[-window_size:]\n            mean = sum(w) / len(w)\n            var = sum((x - mean)  2 for x in w)\n            if var < 1e-7:\n                ar1_val = 0.98 if mean < 1.0 else 0.0\n            else:\n                cov = sum((w[i] - mean) * (w[i+1] - mean) for i in range(len(w)-1))\n                ar1_val = max(-0.99, min(0.99, cov / var))\n                \n        # Orbit Periodicity Tracking (Limit Cycle Detection)\n        orbit_period = None\n        tokens = self.generated_tokens\n        for p in range(1, 9):\n            if len(tokens) >= 2 * p:\n                if tokens[-p:] == tokens[-2*p:-p]:\n                    orbit_period = p\n                    break\n                    \n        # State Stress Evolution\n        warning_active = (ar1_val > self.config.ar1_threshold) or (orbit_period is not None)\n        \n        if warning_active:\n            self.stress += self.config.stress_rise_rate\n        else:\n            self.stress -= self.config.stress_decay_rate\n        self.stress = max(0.0, min(3.0, self.stress))\n        \n        # Schmitt Trigger Decision Framework\n        if not self.intervention_active:\n            if self.stress >= self.config.schmitt_upper:\n                self.intervention_active = True\n                if self.verbose:\n                    print(f\"\\n[STRESS CRITICAL] Step {self.step_counter}: Chaos Core engaging. Stress: {self.stress:.2f}, AR(1): {ar1_val:.3f}, Orbit: {orbit_period}\")\n        else:\n            if self.stress <= self.config.schmitt_lower:\n                self.intervention_active = False\n                if self.verbose:\n                    print(f\"\\n[STRESS DECAYED] Step {self.step_counter}: Chaos Core disengaging. Stress: {self.stress:.2f}\")\n\n        token_str = self.tokenizer.decode([curr_token_id]) if curr_token_id < len(self.tokenizer) else \"\"\n        record = TelemetryRecord(\n            step=self.step_counter,\n            token_id=curr_token_id,\n            token_text=token_str,\n            entropy=entropy,\n            top_prob=top_prob,\n            ar1=ar1_val,\n            stress=self.stress,\n            orbit_period=orbit_period,\n            intervention_active=self.intervention_active\n        )\n        self.telemetry.append(record)\n        self.step_counter += 1\n\n        # Apply Active Remediations\n        modified_scores = scores.clone()\n        if self.intervention_active:\n            # 1. Orbit Penalty (breaks repeating cycles)\n            if orbit_period is not None and self.config.orbit_penalty_strength > 0:\n                p_tokens = set(tokens[-orbit_period:])\n                for t_id in p_tokens:\n                    modified_scores[:, t_id] -= self.config.orbit_penalty_strength\n            \n            # 2. Point Attractor Penalty (suppresses persistent repeating nodes)\n            if len(tokens) > 5 and self.config.point_attractor_penalty > 0:\n                recent = tokens[-20:]\n                counts = Counter(recent)\n                for t_id, count in counts.items():\n                    if count >= 3:\n                        modified_scores[:, t_id] -= (count * 0.2 * self.config.point_attractor_penalty)\n            \n            # 3. Semantic Anchor Boost (restores prompt attention context)\n            if self.config.anchor_boost_strength > 0 and len(self.prompt_tokens) > 0:\n                anchor_tokens = list(set(self.prompt_tokens))\n                for t_id in anchor_tokens:\n                    if t_id < modified_scores.shape[-1]:\n                        modified_scores[:, t_id] += self.config.anchor_boost_strength\n            \n            # 4. Neuromodulation (Dynamic Temperature Scaling)\n            if self.config.max_temperature > 1.0:\n                modified_scores = modified_scores / self.config.max_temperature\n                \n        return modified_scores\n\ndef plot_telemetry_dashboard(telemetry: List[TelemetryRecord], title: str, save_path: str = None):\n    steps = [t.step for t in telemetry]\n    ar1_vals = [t.ar1 for t in telemetry]\n    stress_vals = [t.stress for t in telemetry]\n    entropies = [t.entropy for t in telemetry]\n    top_probs = [t.top_prob for t in telemetry]\n    interventions = [1.0 if t.intervention_active else 0.0 for t in telemetry]\n    orbit_periods = [t.orbit_period if t.orbit_period is not None else 0 for t in telemetry]\n\n    fig, axs = plt.subplots(3, 1, figsize=(12, 10), facecolor=\"#0A0A0A\", sharex=True)\n    \n    for ax in axs:\n        ax.set_facecolor(\"#111111\")\n        ax.grid(True, color=\"#222222\", linestyle=\"--\", linewidth=0.5)\n        ax.tick_params(colors=\"#9E9E9E\", labelsize=9)\n        for spine in ax.spines.values():\n            spine.set_color(\"#222222\")\n\n    ax1 = axs[0]\n    ax1.plot(steps, ar1_vals, color=\"#00E5FF\", linewidth=2, label=\"AR(1) Autocorrelation\")\n    ax1.plot(steps, stress_vals, color=\"#FF1744\", linewidth=2, label=\"Chaos Core Stress\")\n    ax1.axhline(0.75, color=\"#00E5FF\", linestyle=\":\", alpha=0.7, label=\"AR(1) Threshold (0.75)\")\n    ax1.axhline(1.2, color=\"#FF1744\", linestyle=\":\", alpha=0.7, label=\"Stress Critical (1.2)\")\n    ax1.set_ylabel(\"Metrics Scale\", color=\"#E0E0E0\", fontsize=10)\n    ax1.legend(loc=\"upper left\", facecolor=\"#1A1A1A\", edgecolor=\"#333333\", labelcolor=\"#E0E0E0\", fontsize=9)\n    ax1.set_title(\"Cognitive Safety Telemetry (CSD Detection)\", color=\"#E0E0E0\", fontsize=11, fontweight=\"bold\")\n\n    ax2 = axs[1]\n    ax2.plot(steps, entropies, color=\"#FFC400\", linewidth=1.8, label=\"Token Entropy\")\n    ax2.plot(steps, top_probs, color=\"#00E676\", linewidth=1.5, linestyle=\"--\", label=\"Top Token Probability\")\n    ax2.set_ylabel(\"Information Metrics\", color=\"#E0E0E0\", fontsize=10)\n    ax2.legend(loc=\"upper left\", facecolor=\"#1A1A1A\", edgecolor=\"#333333\", labelcolor=\"#E0E0E0\", fontsize=9)\n\n    ax3 = axs[2]\n    ax3.fill_between(steps, 0, interventions, color=\"#FF1744\", alpha=0.15, label=\"Intervention Active\")\n    ax3.plot(steps, interventions, color=\"#FF1744\", linewidth=1.5, alpha=0.6)\n    \n    orbit_steps = [s for s, o in zip(steps, orbit_periods) if o > 0]\n    orbit_vals = [o for o in orbit_periods if o > 0]\n    if orbit_steps:\n        ax3.scatter(orbit_steps, orbit_vals, color=\"#D500F9\", s=40, zorder=5, label=\"Detected Orbit Period\")\n    ax3.plot(steps, orbit_periods, color=\"#D500F9\", linewidth=1, alpha=0.3, linestyle=\":\")\n    ax3.set_ylabel(\"Limit Cycles & Action\", color=\"#E0E0E0\", fontsize=10)\n    ax3.set_xlabel(\"Generation Step\", color=\"#E0E0E0\", fontsize=10)\n    ax3.legend(loc=\"upper left\", facecolor=\"#1A1A1A\", edgecolor=\"#333333\", labelcolor=\"#E0E0E0\", fontsize=9)\n\n    for ax in axs:\n        for idx in range(len(steps) - 1):\n            if interventions[idx] > 0:\n                ax.axvspan(steps[idx], steps[idx+1], color=\"#FF1744\", alpha=0.03)\n\n    plt.suptitle(title, color=\"#FFFFFF\", fontsize=13, fontweight=\"bold\", y=0.96)\n    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n    if save_path:\n        plt.savefig(save_path, dpi=150, facecolor=\"#0A0A0A\")\n    return fig\n\ndef plot_comparison(\n    baseline_telemetry: List[TelemetryRecord],\n    monitored_telemetry: List[TelemetryRecord],\n    baseline_text: str,\n    monitored_text: str,\n    save_path: str = None\n):\n    fig, axs = plt.subplots(2, 1, figsize=(12, 8), facecolor=\"#0A0A0A\")\n    \n    for ax in axs:\n        ax.set_facecolor(\"#111111\")\n        ax.grid(True, color=\"#222222\", linestyle=\"--\", linewidth=0.5)\n        ax.tick_params(colors=\"#9E9E9E\", labelsize=9)\n        for spine in ax.spines.values():\n            spine.set_color(\"#222222\")\n\n    ax1 = axs[0]\n    base_steps = [t.step for t in baseline_telemetry]\n    base_stress = [t.stress for t in baseline_telemetry]\n    mon_steps = [t.step for t in monitored_telemetry]\n    mon_stress = [t.stress for t in monitored_telemetry]\n    \n    ax1.plot(base_steps, base_stress, color=\"#90A4AE\", linewidth=1.5, linestyle=\"--\", label=\"Baseline Stress (No Intervention)\")\n    ax1.plot(mon_steps, mon_stress, color=\"#FF1744\", linewidth=2.5, label=\"Chaos Core Stress (With Intervention)\")\n    ax1.axhline(1.2, color=\"#FF1744\", linestyle=\":\", alpha=0.7, label=\"Stress Critical Threshold\")\n    ax1.set_ylabel(\"Cognitive Stress\", color=\"#E0E0E0\", fontsize=10)\n    ax1.set_title(\"Stress Trajectory Comparison\", color=\"#E0E0E0\", fontsize=11, fontweight=\"bold\")\n    ax1.legend(loc=\"upper left\", facecolor=\"#1A1A1A\", edgecolor=\"#333333\", labelcolor=\"#E0E0E0\")\n\n    ax2 = axs[1]\n    def compute_rolling_diversity(text, window=15):\n        words = text.split()\n        divs = []\n        for i in range(len(words)):\n            start = max(0, i - window)\n            sub = words[start:i+1]\n            if len(sub) == 0:\n                divs.append(1.0)\n            else:\n                divs.append(len(set(sub)) / len(sub))\n        return divs\n\n    base_div = compute_rolling_diversity(baseline_text)\n    mon_div = compute_rolling_diversity(monitored_text)\n    \n    ax2.plot(range(len(base_div)), base_div, color=\"#EF5350\", linewidth=1.5, linestyle=\"--\", label=\"Baseline Rolling Diversity\")\n    ax2.plot(range(len(mon_div)), mon_div, color=\"#66BB6A\", linewidth=2.5, label=\"RESONATOR Rolling Diversity\")\n    ax2.set_ylabel(\"Rolling Vocabulary Diversity\", color=\"#E0E0E0\", fontsize=10)\n    ax2.set_xlabel(\"Token Index\", color=\"#E0E0E0\", fontsize=10)\n    ax2.set_title(\"Rolling Vocabulary Diversity (Higher = Coherent, Lower = Repetition)\", color=\"#E0E0E0\", fontsize=11, fontweight=\"bold\")\n    ax2.legend(loc=\"lower left\", facecolor=\"#1A1A1A\", edgecolor=\"#333333\", labelcolor=\"#E0E0E0\")\n    \n    plt.suptitle(\"RESONATOR System Comparison: Safety and Coherence Analysis\", color=\"#FFFFFF\", fontsize=13, fontweight=\"bold\", y=0.97)\n    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n    if save_path:\n        plt.savefig(save_path, dpi=150, facecolor=\"#0A0A0A\")\n    return fig\n\ndef print_telemetry_table(telemetry: List[TelemetryRecord], max_rows: int = 40):\n    print(\"┌──────┬──────────────────┬──────────┬──────────┬───────┬────────────┐\")\n    print(\"│ Step │ Generated Token  │ AR(1)    │ Stress   │ Orbit │ Active?    │\")\n    print(\"├──────┼──────────────────┼──────────┼──────────┼───────┼────────────┤\")\n    for idx, t in enumerate(telemetry[:max_rows]):\n        token_txt = t.token_text.replace(\"\\n\", \"\\\\n\").replace(\"\\t\", \"\\\\t\")\n        if len(token_txt) > 16:\n            token_txt = token_txt[:13] + \"...\"\n        orbit_str = str(t.orbit_period) if t.orbit_period is not None else \"-\"\n        active_str = \"ACTIVE\" if t.intervention_active else \"idle\"\n        print(f\"│ {t.step:<4} │ {token_txt:<16} │ {t.ar1:<8.4f} │ {t.stress:<8.4f} │ {orbit_str:<5} │ {active_str:<10} │\")\n    if len(telemetry) > max_rows:\n        print(f\"│ ...  │ ...              │ ...      │ ...      │ ...   │ ...        │\")\n    print(\"└──────┴──────────────────┴──────────┴──────────┴───────┴────────────┘\")\n''')\n\n# Configure sys path to find the module\nsys.path.insert(0, os.path.abspath("."))\n\nfrom resonator import (\n    ChaosCore, ChaosConfig,\n    plot_telemetry_dashboard, plot_comparison, print_telemetry_table\n)\n\nprint("✓ Imports and Package Generation Completed Successfully")\nprint(f"  PyTorch version: {torch.version}")\nprint(f"  CUDA available: {torch.cuda.is_available()}")\nif torch.cuda.is_available():\n    print(f"  GPU Name: {torch.cuda.get_device_name(0)}")\nelse:\n    print("  ⚠️ WARNING: No GPU detected. Notebook will fall back to CPU. Ensure GPU is enabled via Colab: Runtime -> Change runtime type.")"
]
